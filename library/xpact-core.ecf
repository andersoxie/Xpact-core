<?xml version="1.0" encoding="ISO-8859-1"?>
<system name="xpact" xmlns="http://www.eiffel.com/developers/xml/configuration-1-23-0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.eiffel.com/developers/xml/configuration-1-23-0 http://www.eiffel.com/developers/xml/configuration-1-23-0.xsd" library_target="xpact_core" uuid="5C280ACE-B87D-44D1-838B-1FEB8F211452">
	<target name="xpact_core">
		<description>
export:
	XPACT_INCLUDE = "$XPACT_CORE/contrib/xpact/include"
	C_SHIFT_JIS_SUBSET = "$XPACT_CORE/C-tools/shift_jis_subset"
		</description>
		<root all_classes="true"/>
		<option  full_class_checking="false" is_obsolete_routine_type="true"  syntax="standard" warning="warning">
			<assertions precondition="true" postcondition="true" check="true" invariant="true" loop="true" supplier_precondition="true"/>
		</option>
		<capability>
			<concurrency support="none"/>
			<void_safety support="all" use="all"/>
		</capability>
		<library name="base" location="$ISE_LIBRARY\library\base\base.ecf" readonly="true"/>
		<library name="base_ext" location="$ISE_LIBRARY\library\base_extension\base_extension.ecf" readonly="true"/>
		<library name="time" location="$ISE_LIBRARY\library\time\time.ecf" readonly="true"/>
		<library name="c_zlib" location="$ISE_LIBRARY\C_library\zlib\clibs_zlib.ecf"/>
		<external_include location="$(XPACT_INCLUDE)"/>

		<external_include location="$(C_SHIFT_JIS_SUBSET)/include"/>
		<external_object location="$(C_SHIFT_JIS_SUBSET)/lib/libshift_jis_subset.a">
			<condition>
				<platform value="unix"/>
			</condition>
		</external_object>
		
		<cluster name="eiffel_loop" location="../contrib/Eiffel-Loop" recursive="true"/>
		<!--cluster name="xpact-so" location="$EIFFEL/library/xpact/src" recursive="true"/-->

		<cluster name="xpact" location="source" recursive="true">
			<file_rule>
				<exclude>/small-size$</exclude>
				<!--exclude>/expat$</exclude-->
				<condition>
					<custom name="buffer_size" excluded_value="small"/>
				</condition>
			</file_rule>
			<file_rule>
				<exclude>/big-size$</exclude>
				<!--exclude>/expat$</exclude-->
				<condition>
					<custom name="buffer_size" excluded_value="big"/>
				</condition>
			</file_rule>
		</cluster>
	
	</target>
</system>
